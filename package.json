{
    "name": "code-monitor",
    "displayName": "Code Monitor",
    "description": "Automated Technical Screening Platform — Student Monitor",
    "version": "1.0.6",
    "publisher": "screening-platform",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "codeMonitor",
                    "title": "Code Monitor",
                    "icon": "icon-sidebar.svg"
                }
            ]
        },
        "views": {
            "codeMonitor": [
                {
                    "id": "codeMonitorFileSessions",
                    "name": "My Files"
                }
            ]
        },
        "commands": [
            {
                "command": "code-monitor.login",
                "title": "Code Monitor: Login to Exam"
            },
            {
                "command": "code-monitor.logout",
                "title": "Code Monitor: Logout from Exam"
            },
            {
                "command": "code-monitor.status",
                "title": "Code Monitor: View My Status"
            },
            {
                "command": "code-monitor.analyzeCode",
                "title": "Code Monitor: Analyze Code (AI Detection)"
            }
        ],
        "configuration": {
            "title": "Code Monitor",
            "properties": {
                "codeMonitor.serverUrl": {
                    "type": "string",
                    "default": "https://screening-platform-tpku.onrender.com",
                    "markdownDescription": "Backend server address, e.g. `http://127.0.0.1:8000` for a local test server.",
                    "scope": "machine"
                }
            }
        }
    },
    "scripts": {
        "lint": "eslint ."
    },
    "devDependencies": {
        "@types/vscode": "^1.85.0",
        "@vscode/test-cli": "^0.0.4",
        "@vscode/test-electron": "^2.3.8"
    }
}
