{
  "name": "code-monitor",
  "displayName": "code-monitor",
  "description": "Monitor student code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "commands": [
        {
            "command": "code-monitor.login",
            "title": "Code Monitor: Login to Exam"
        },
        {
            "command": "code-monitor.logout",
            "title": "Code Monitor: Logout from Exam"
        },
        {
            "command": "code-monitor.status",
            "title": "Code Monitor: View My Status"
        }
    ]
},
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.120.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "eslint": "^9.39.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
